generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  provider   String
  providerId String    @map("provider_id")
  name       String
  email      String?
  picture    String?
  participations MarathonParticipation[]
  records        Activity[]
  userBadges     UserBadge[]
  notifications  Notification[]
  shoes          Shoe[]
  trainingPlans  TrainingPlan[]
  mcpGrants      McpGrant[]
  customMarathons Marathon[]
  @@unique([provider, providerId])
  @@map("users")
}

model Marathon {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  name            String
  date            String
  location        String   @default("")
  city            String   @default("")
  categories      String   @default("")
  description     String   @default("")
  officialUrl     String   @default("") @map("official_url")
  entryFee        Int      @default(0) @map("entry_fee")
  maxParticipants Int      @default(0) @map("max_participants")
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       Int?     @map("created_by") // 직접 추가한 사용자. 크롤링한 대회는 null, 값이 있으면 그 사용자에게만 보임
  participations MarathonParticipation[]
  creator        User?    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  @@index([createdBy])
  @@map("marathons")
}

model MarathonParticipation {
  id             Int       @id @default(autoincrement())
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  userId         Int       @map("user_id")
  marathonId     Int       @map("marathon_id")
  category       String    @default("")
  finishTime     Int?      @map("finish_time")
  goalTime       Int?      @map("goal_time") // 목표 기록(초)
  raceNotes      String?   @map("race_notes")
  certificateUrl String?   @map("certificate_url")
  user    User    @relation(fields: [userId], references: [id])
  marathon Marathon @relation(fields: [marathonId], references: [id])
  @@unique([userId, marathonId])
  @@map("marathon_participations")
}

model Activity {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  userId      Int?      @map("user_id")
  date        String
  distance    Float
  duration    Int       // 이동 시간(초). 정지 시간 제외, 페이스 계산 기준
  elapsed     Int?      // 총 경과 시간(초). 정지 시간 포함. 모르면 null
  externalId  String?   @map("external_id") // 워치 활동 고유 ID (TCX 의 Activity/Id). 중복 판정에 가장 먼저 씀
  pace        String    @default("")
  paceSeconds Int       @default(0) @map("pace_seconds")
  heartRate   Int       @default(0) @map("heart_rate")
  maxHeartRate Int      @default(0) @map("max_heart_rate")
  calories    Int       @default(0)
  routeType   String    @default("road") @map("route_type")
  runType     String    @default("") @map("run_type") // "" | "easy" | "long" | "tempo" | "interval" | "race"
  weather     String    @default("")
  notes       String    @default("")
  marathonId  Int?      @map("marathon_id")
  routeData   String    @default("") @map("route_data")
  shoeId      Int?      @map("shoe_id")
  user User? @relation(fields: [userId], references: [id])
  shoe Shoe? @relation(fields: [shoeId], references: [id], onDelete: SetNull)
  @@index([userId, distance])
  @@index([userId, duration])
  @@index([userId, paceSeconds])
  @@index([userId, date])
  @@index([shoeId])
  @@unique([userId, externalId])
  @@map("activities")
}

model Shoe {
  id         Int        @id @default(autoincrement())
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  userId     Int        @map("user_id")
  name       String
  brand      String     @default("")
  model      String     @default("")
  purpose    String     @default("") // 용도 메모. 예: "이지런·롱런"
  startKm    Float      @default(0) @map("start_km") // 등록 전에 이미 달린 거리
  retiredAt  DateTime?  @map("retired_at")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  @@index([userId])
  @@map("shoes")
}

model TrainingPlan {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    Int      @map("user_id")
  date      String   // "YYYY-MM-DD", 하루에 계획 하나
  kind      String   @default("run") // "run" | "strength" | "both" | "rest"
  title     String   @default("")
  detail    String   @default("")
  done      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@map("training_plans")
}

// Claude 커넥터(MCP) 연결 1건. 토큰 원문은 저장하지 않고 해시만 보관
model McpGrant {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at")
  userId      Int       @map("user_id")
  clientName  String    @default("") @map("client_name")
  codeId      String    @unique @map("code_id")      // 인가 코드 1회 사용 보장
  refreshHash String    @unique @map("refresh_hash") // 리프레시 토큰 SHA-256
  lastUsedAt  DateTime? @map("last_used_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("mcp_grants")
}

model BadgeDefinition {
  id          Int         @id @default(autoincrement())
  code        String      @unique
  type        String      // "monthly_km" | "streak" | "personal_best"
  name        String
  description String      @default("")
  icon        String      @default("")
  threshold   Int         @default(0)
  unit        String      @default("")
  userBadges  UserBadge[]
  @@map("badge_definitions")
}

model UserBadge {
  id          Int              @id @default(autoincrement())
  createdAt   DateTime         @default(now()) @map("created_at")
  userId      Int              @map("user_id")
  badgeId     Int              @map("badge_id")
  year        Int?
  month       Int?
  awardedAt   DateTime         @default(now()) @map("awarded_at")
  user        User             @relation(fields: [userId], references: [id])
  badge       BadgeDefinition  @relation(fields: [badgeId], references: [id])
  @@unique([userId, badgeId, year, month])
  @@index([userId])
  @@map("user_badges")
}

model Notification {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int      @map("user_id")
  type      String   // "dday_7" | "dday_1" | "badge"
  refId     String   @map("ref_id")
  title     String
  body      String   @default("")
  isRead    Boolean  @default(false) @map("is_read")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type, refId])
  @@index([userId, isRead])
  @@map("notifications")
}
